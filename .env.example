# ---------------------------------------------------------------------------
# ReconX configuration. Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

# Storage. SQLite needs no setup. For Postgres use:
#   postgresql+asyncpg://user:pass@localhost:5432/reconx
RECONX_DATABASE_URL=sqlite+aiosqlite:///./data/reconx.db

# Where scan artifacts land
RECONX_DATA_DIR=./data

# --- Politeness / rate limiting -------------------------------------------
# Deliberately conservative defaults. Raise only within your program's rules.
RECONX_REQUESTS_PER_SECOND_PER_HOST=5.0
RECONX_MAX_CONCURRENT_REQUESTS=20
RECONX_MAX_CONCURRENT_HOSTS=10
RECONX_HTTP_TIMEOUT_SECONDS=15
RECONX_USER_AGENT=ReconX/0.1 (authorized security research)

# --- Verification engine ---------------------------------------------------
# How many times a candidate finding must reproduce before it is reported.
RECONX_REPRODUCE_ATTEMPTS=3
RECONX_REPRODUCE_REQUIRED=3
# Minimum confidence (0-100) for a finding to surface by default
RECONX_MIN_REPORT_CONFIDENCE=50
# Use headless Chromium to confirm XSS actually executes
RECONX_HEADLESS_XSS_CONFIRM=true

# --- Notifications (leave blank to disable) --------------------------------
RECONX_DISCORD_WEBHOOK=
RECONX_SLACK_WEBHOOK=
RECONX_TELEGRAM_BOT_TOKEN=
RECONX_TELEGRAM_CHAT_ID=
RECONX_GENERIC_WEBHOOK=

# --- API ------------------------------------------------------------------
RECONX_API_HOST=127.0.0.1
RECONX_API_PORT=8000

# --- Optional API keys for passive recon sources ---------------------------
# All optional; ReconX works without them, just with fewer passive sources.
RECONX_SHODAN_API_KEY=
RECONX_SECURITYTRAILS_API_KEY=
RECONX_VIRUSTOTAL_API_KEY=
RECONX_GITHUB_TOKEN=
